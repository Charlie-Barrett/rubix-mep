---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';

const {
  title,
  description,
  headerVariant = 'default',
  showCta = true,
  ctaTitle,
  ctaSub,
  ctaPrimaryHref,
  ctaPrimaryLabel,
  ctaSecondaryHref,
  ctaSecondaryLabel
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/logo-blue.png" />
  </head>
  <body>
    <Header variant={headerVariant} />
    <slot />
    {showCta && (
      <Cta
        title={ctaTitle}
        sub={ctaSub}
        primaryHref={ctaPrimaryHref}
        primaryLabel={ctaPrimaryLabel}
        secondaryHref={ctaSecondaryHref}
        secondaryLabel={ctaSecondaryLabel}
      />
    )}
    <Footer />
    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>

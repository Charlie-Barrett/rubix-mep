---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';

const {
  title,
  description,
  headerVariant = 'default',
  headerTone = 'dark',
  showCta = true,
  ctaTitle,
  ctaSub,
  ctaKind,
  ctaOnNavy = false,
  image = '/assets/og-image.jpg'
} = Astro.props;

// Canonical: apex domain, no trailing slash except the homepage.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <!-- Google consent defaults: everything denied until the visitor chooses in the Cookiebot banner. -->
    <script is:inline data-cookieconsent="ignore">
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'denied',
        personalization_storage: 'denied', security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', false);
    </script>
    <!-- Cookiebot consent banner: first external script so auto-blocking can hold back cookies until consent. -->
    <script is:inline id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="d376d24e-91fd-4bff-a1c4-00867f89529e" data-blockingmode="auto" type="text/javascript"></script>
    <!-- GA4: only loads once the visitor accepts statistics cookies. -->
    <script is:inline type="text/plain" data-cookieconsent="statistics" async src="https://www.googletagmanager.com/gtag/js?id=G-BEGM9D9JKN"></script>
    <script is:inline type="text/plain" data-cookieconsent="statistics">
      gtag('js', new Date());
      gtag('config', 'G-BEGM9D9JKN');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rubix MEP" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#202F58" />
  </head>
  <body>
    <Header variant={headerVariant} tone={headerTone} />
    <slot />
    {showCta && (
      <Cta title={ctaTitle} sub={ctaSub} kind={ctaKind} onNavy={ctaOnNavy} />
    )}
    <Footer />
    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>

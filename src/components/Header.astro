---
// Site-wide header: hamburger + persistent CTA. On the homepage the logo is
// omitted (the brand hero logo docks into the corner instead, per comp V3).
const { variant = 'default' } = Astro.props;
---
<header class="header" id="header">
  <div class="wrap">
    {variant !== 'home' && (
      <a class="logo" href="/">
        <img src="/assets/logo-blue-mep.png" alt="Rubix MEP Consultants" width="150" />
      </a>
    )}
    <div class="hdr-right">
      <a href="/contact" class="btn btn-lime">Discuss your project</a>
      <button class="burger" id="burger" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu">
  <button class="close" id="menuClose" aria-label="Close menu">&times;</button>
  <nav>
    <a href="/services">Services</a>
    <a href="/projects">Projects</a>
    <a href="/capabilities">Capabilities</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>
  <div class="menu-cta">
    <a href="/contact" class="btn btn-lime">Discuss your project <span class="arr">&rarr;</span></a>
  </div>
  <img src="/assets/logo-white-mep.png" alt="Rubix MEP" width="170" />
</div>

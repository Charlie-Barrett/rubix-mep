---
// Jewellery Quarter line drawing used on About (white strip) and Contact (navy hero).
// 01.10 review: each building takes a different Rubix colour. `onDark` swaps navy
// for white so the drawing still reads on the navy banner. Pass `mono` to fall
// back to a single-colour outline if the client decides the multicolour looks off.
const { class: cls = '', onDark = false, mono = false } = Astro.props;
const navy = onDark ? '#FFFFFF' : '#202F58';
const lime = '#7AB529', pink = '#CC1383', blue = '#3F90CE';
const c = mono
  ? { base: navy, b1: navy, b2: navy, b3: navy, b4: navy, b5: navy, b6: navy, arch: navy, tree: navy }
  : { base: blue, b1: navy, b2: lime, b3: pink, b4: blue, b5: lime, b6: navy, arch: pink, tree: lime };
---

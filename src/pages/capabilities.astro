---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages.css';
---
<BaseLayout
  title="Capabilities | MEP Consultants | Rubix MEP"
  description="Rubix MEP capabilities: RIBA 0-7 MEP design, energy strategies, thermal modelling, BIM Level 2 delivery and carbon impact studies across all industry sectors. Download the brochure."
  ctaSub="Book a conversation, or take our capabilities away to review."
>
  <section class="page-hero">
    <div class="bg" role="img" aria-label="City skyline blended with forest treeline in Rubix navy duotone"></div>
    <div class="wrap">
      <div class="eyebrow rv"><span class="dot"></span>Capabilities &middot; RIBA Stages 0&ndash;7</div>
      <h1 class="disp rv rv-d1">Delivering <span class="c-green">low-carbon</span>, innovative building services design solutions, tailored to your needs</h1>
      <p class="lede rv rv-d2">The full picture of what Rubix MEP does, how we work through every RIBA stage, and the sectors and clients we deliver for. Available on this page, or as a PDF to take away.</p>
      <div class="ctas rv rv-d3" style="margin-top:30px; display:flex; gap:14px; flex-wrap:wrap;">
        <a href="#brochure" class="btn btn-lime">Download the brochure <span class="arr">&darr;</span></a>
        <a href="#enquire" class="btn btn-ghost">Discuss your project</a>
      </div>
    </div>
  </section>

  <!-- PRINCIPAL SERVICES -->
  <section class="sec-pad">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Principal <b>services</b></h2>
        <p>Our areas of expertise, commissioned individually or as a full MEP design package.</p>
      </div>
      <ul class="cap-list rv rv-d1">
        <li>RIBA Stage 0&ndash;7 MEP design</li>
        <li>MEP due diligence: building &amp; site acquisitions</li>
        <li>Planning application support</li>
        <li>Low-to-Zero <span class="c-green">Carbon</span> (LZC) assessments, whole life cost appraisals and reporting</li>
        <li>Energy strategies and predicted energy modelling</li>
        <li>Thermal dynamic simulations and overheating assessments</li>
        <li>Level 2 BIM delivery, including development of BIM execution plans</li>
        <li>MEP 2D &amp; 3D modelling</li>
        <li>Plant access &amp; maintenance strategies</li>
        <li>MEP condition surveys and reporting</li>
        <li>Technical advisor role / clerk of works</li>
        <li>Witnessing, commissioning and project close-out</li>
        <li>Soft landings and post-occupation energy assessment</li>
        <li>Site-wide <span class="c-green">carbon</span> impact studies</li>
      </ul>
    </div>
  </section>

  <!-- DESIGN FLOW -->
  <section class="sec-pad soft">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>From concept to completion, <b>and beyond</b></h2>
        <p>A comprehensive MEP design package across RIBA Stages 0&ndash;7. We&rsquo;re here to help at every step.</p>
      </div>
      <div class="flow">
        <div class="fcard rv">
          <span class="stage">Pre-construction &middot; RIBA 0&ndash;4</span>
          <h3>From concept</h3>
          <ul>
            <li>Pre-planning advice, passive design appraisals and building massing input</li>
            <li>Site surveys, due diligence and energy strategy development</li>
            <li>SBEM / SAP analysis and infrastructure load assessments</li>
            <li>MEP specifications, schedules and drawings</li>
            <li>Utility connections and full MEP design package to suit requirements</li>
          </ul>
        </div>
        <div class="fcard c2 rv rv-d1">
          <span class="stage">Construction &middot; RIBA 5</span>
          <h3>To completion</h3>
          <ul>
            <li>Tender interviews, M&amp;E cost reviews and contractor appointment support</li>
            <li>Review of contractor drawings and deliverables</li>
            <li>Building Regulations and Part L reviews</li>
            <li>Installation and commissioning programme reviews</li>
            <li>Site inspections and reporting</li>
          </ul>
        </div>
        <div class="fcard c3 rv rv-d2">
          <span class="stage">Handover &amp; in-use &middot; RIBA 6&ndash;7</span>
          <h3>And beyond</h3>
          <ul>
            <li>Testing and commissioning programme review and witnessing</li>
            <li>O&amp;M manual and handover documentation review</li>
            <li>Practical Completion MEP services report</li>
            <li>Seasonal commissioning reviews</li>
            <li>Soft Landings aftercare, where appropriate</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="sec-pad">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Proudly covering <b>all industry sectors</b></h2>
      </div>
      <div class="sector-grid rv rv-d1">
        <span>Heritage</span>
        <span>Residential</span>
        <span>Commercial</span>
        <span>Industrial &amp; Logistics</span>
        <span>Retail, Leisure &amp; Hospitality</span>
        <span>Education</span>
        <span>Healthcare &amp; Life Sciences</span>
        <span>Defence</span>
        <span>Energy &amp; Infrastructure</span>
      </div>
    </div>
  </section>

  <!-- VALUED CLIENTS -->
  <section class="sec-pad soft">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Our valued <b>clients &amp; partners</b></h2>
      </div>
      <div class="client-grid rv rv-d1">
        <div class="lg"><img src="/assets/client-national-trust.png" alt="National Trust" /></div>
        <div class="lg"><img src="/assets/client-office-national-statistics.png" alt="Office for National Statistics" /></div>
        <div class="lg"><img src="/assets/client-met-office.png" alt="Met Office" /></div>
        <div class="lg"><img src="/assets/client-cbre.png" alt="CBRE" /></div>
        <div class="lg"><img src="/assets/client-severn-trent.png" alt="Severn Trent" /></div>
        <div class="lg"><img src="/assets/client-urban-splash.png" alt="Urban Splash" /></div>
        <div class="lg"><img src="/assets/client-barchester.png" alt="Barchester Healthcare" /></div>
        <div class="lg"><img src="/assets/client-space-group.png" alt="Space Group" /></div>
        <div class="lg"><img src="/assets/client-hallmark.png" alt="Hallmark Luxury Care Homes" /></div>
        <div class="lg"><img src="/assets/client-lovett-care.png" alt="Lovett Care Homes" /></div>
        <div class="lg"><img src="/assets/client-majesticare.png" alt="Majesticare" /></div>
        <div class="lg"><img src="/assets/client-opus.png" alt="Opus Villages" /></div>
        <div class="lg"><img src="/assets/client-regal.png" alt="Regal" /></div>
        <div class="lg"><img src="/assets/client-wren.png" alt="WREN" /></div>
        <div class="lg"><img src="/assets/client-buildfifty5.png" alt="Build Fifty5" /></div>
        <div class="lg"><img src="/assets/client-create-if.png" alt="Create.iF" /></div>
        <div class="lg"><img src="/assets/client-fabric-plus.png" alt="Fabric+" /></div>
        <div class="lg"><img src="/assets/client-mcleod-aitken.png" alt="McLeod + Aitken" /></div>
        <div class="lg"><img src="/assets/client-holden-lee.png" alt="Holden + Lee" /></div>
        <div class="lg"><img src="/assets/client-format-architects.png" alt="Format Architects" /></div>
        <div class="lg"><img src="/assets/client-angela-swift.png" alt="Angela Swift Developments" /></div>
        <div class="lg"><img src="/assets/client-elevate-property.png" alt="Elevate Property Group" /></div>
        <div class="lg"><img src="/assets/client-cadence-projects.png" alt="Cadence Projects" /></div>
        <div class="lg"><img src="/assets/client-sunrise-facilities.png" alt="Sunrise Facilities Management" /></div>
      </div>

    </div>
  </section>

  <!-- THE BROCHURE: what it is and why you would want it.
       Gated: the form posts to HubSpot ("Website: Brochure download") via
       public/js/site.js, then the PDF downloads and a fallback link shows.
       Soft gate only: the PDF URL itself is public. -->
  <section class="sec-pad" id="brochure">
    <div class="wrap">
      <div class="brochure rv">
        <div class="bro-copy">
          <div class="ndash"></div>
          <h2>The Rubix MEP capabilities brochure</h2>
          <p class="bro-lede">Thirty-two pages covering who we are, the full range of MEP design services, how we work through each RIBA stage, the ten sectors we deliver in, and the project case studies behind the numbers.</p>
          <ul class="bro-why">
            <li><b>Specifying a project team.</b> Everything a consultant selection or PQQ needs, in one document, without a call first.</li>
            <li><b>Building a business case.</b> Worked <span class="c-green">carbon</span> and energy outcomes on real schemes, with values and stages.</li>
            <li><b>Sharing internally.</b> A single PDF for colleagues who were not in the room.</li>
          </ul>
          <div class="enq bro-gate" data-enquiry id="brochure-form">
            <form method="post" action="#" novalidate>
              <input type="hidden" name="enquiry_type" value="brochure" />
              <div class="hp" aria-hidden="true"><label for="bro-website">Website</label><input id="bro-website" name="website_url" type="text" tabindex="-1" autocomplete="off" /></div>
              <div class="fields">
                <div><label for="bro-first">First name</label><input id="bro-first" name="firstname" type="text" autocomplete="given-name" required /></div>
                <div><label for="bro-last">Last name</label><input id="bro-last" name="lastname" type="text" autocomplete="family-name" required /></div>
                <div><label for="bro-email">Work email</label><input id="bro-email" name="email" type="email" autocomplete="email" required /></div>
                <div><label for="bro-company">Company</label><input id="bro-company" name="company" type="text" autocomplete="organization" required /></div>
                <div class="full"><label for="bro-type">Which best describes you? (optional)</label>
                  <select id="bro-type" name="client_type">
                    <option value="">Select</option>
                    <option value="architect">Architect</option>
                    <option value="developer_client">Developer or client</option>
                    <option value="contractor">Contractor</option>
                    <option value="consultant">Other consultant</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>
              <label class="optin"><input type="checkbox" name="marketing_optin" value="yes" /><span>Send me occasional updates on Rubix MEP projects and insights. You can unsubscribe at any time.</span></label>
              <div class="row">
                <p class="fine">We use your details to send the brochure and follow up on it. See our <a href="/privacy">privacy notice</a>.</p>
                <button type="submit" class="btn btn-lime">Get the brochure (PDF) <span class="arr">&darr;</span></button>
              </div>
              <p class="err" role="alert" hidden>Sorry, that didn&rsquo;t go through. Please try again, or email <a href="mailto:info@rubixmep.com">info@rubixmep.com</a> and we will send it over.</p>
            </form>
            <div class="done" role="status">
              <h3>Thank you</h3>
              <p>Your download should start automatically. If it doesn&rsquo;t, <a href="/Rubix-Capabilities-Brochure.pdf" download data-download>download the brochure here</a>.</p>
            </div>
          </div>
        </div>
        <a class="bro-cover" href="#brochure-form" aria-label="Get the Rubix MEP capabilities brochure">
          <span class="sheet-1" aria-hidden="true"></span>
          <span class="sheet-2" aria-hidden="true"></span>
          <span class="sheet-3" aria-hidden="true">
            <img src="/assets/logo-white-tile-mep.png" alt="" />
            <b>Capabilities</b>
            <i>32 pages &middot; PDF</i>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages.css';
---
<BaseLayout
  title="Capabilities | Chartered MEP Consultants | Rubix MEP"
  description="Rubix MEP capabilities: RIBA 0-7 MEP design, energy strategies, thermal modelling, BIM Level 2 delivery and carbon impact studies across all industry sectors. Download the brochure."
  ctaSub="Book a conversation, or take our capabilities away to review."
>
  <section class="page-hero">
    <div class="bg" role="img" aria-label="City skyline blended with forest treeline in Rubix navy duotone"></div>
    <div class="wrap">
      <div class="eyebrow rv"><span class="dot"></span>Capabilities &middot; RIBA Stages 0&ndash;7</div>
      <h1 class="disp rv rv-d1">Delivering low-<span class="c-green">carbon</span>, innovative building services design solutions, tailored to your needs</h1>
      <p class="lede rv rv-d2">The full picture of what Rubix MEP does, how we work through every RIBA stage, and the sectors and clients we deliver for. Available on this page, or as a PDF to take away.</p>
      <div class="ctas rv rv-d3" style="margin-top:30px; display:flex; gap:14px; flex-wrap:wrap;">
        <a href="/Rubix-Capabilities-Brochure.pdf" class="btn btn-lime" download>Download the brochure (PDF) <span class="arr">&darr;</span></a>
        <a href="/contact" class="btn btn-ghost">Discuss your project</a>
      </div>
    </div>
  </section>

  <!-- PRINCIPAL SERVICES -->
  <section class="sec-pad">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Principal <b>services</b></h2>
        <p>Our areas of expertise, commissioned individually or as a full MEP design package.</p>
      </div>
      <ul class="cap-list rv rv-d1">
        <li>RIBA Stage 0&ndash;7 MEP design</li>
        <li>MEP due diligence: building &amp; site acquisitions</li>
        <li>Planning application support</li>
        <li>Low-to-Zero <span class="c-green">Carbon</span> (LZC) assessments, whole life cost appraisals and reporting</li>
        <li>Energy strategies and predicted energy modelling</li>
        <li>Thermal dynamic simulations and overheating assessments</li>
        <li>Level 2 BIM delivery, including development of BIM execution plans</li>
        <li>MEP 2D &amp; 3D modelling</li>
        <li>Plant access &amp; maintenance strategies</li>
        <li>MEP condition surveys and reporting</li>
        <li>Technical advisor role / clerk of works</li>
        <li>Witnessing, commissioning and project close-out</li>
        <li>Soft landings and post-occupation energy assessment</li>
        <li>Site-wide <span class="c-green">carbon</span> impact studies</li>
      </ul>
    </div>
  </section>

  <!-- DESIGN FLOW -->
  <section class="sec-pad soft">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>From concept to completion, <b>and beyond</b></h2>
        <p>A comprehensive MEP design package across RIBA Stages 0&ndash;7. We&rsquo;re here to help at every step.</p>
      </div>
      <div class="flow">
        <div class="fcard rv">
          <span class="stage">Pre-construction &middot; RIBA 0&ndash;4</span>
          <h3>From concept</h3>
          <ul>
            <li>Pre-planning advice, passive design appraisals and building massing input</li>
            <li>Site surveys, due diligence and energy strategy development</li>
            <li>SBEM / SAP analysis and infrastructure load assessments</li>
            <li>MEP specifications, schedules and drawings</li>
            <li>Utility connections and full MEP design package to suit requirements</li>
          </ul>
        </div>
        <div class="fcard c2 rv rv-d1">
          <span class="stage">Construction &middot; RIBA 5</span>
          <h3>To completion</h3>
          <ul>
            <li>Tender interviews, M&amp;E cost reviews and contractor appointment support</li>
            <li>Review of contractor drawings and deliverables</li>
            <li>Building Regulations and Part L reviews</li>
            <li>Installation and commissioning programme reviews</li>
            <li>Site inspections and reporting</li>
          </ul>
        </div>
        <div class="fcard c3 rv rv-d2">
          <span class="stage">Handover &amp; in-use &middot; RIBA 6&ndash;7</span>
          <h3>And beyond</h3>
          <ul>
            <li>Testing and commissioning programme review and witnessing</li>
            <li>O&amp;M manual and handover documentation review</li>
            <li>Practical Completion MEP services report</li>
            <li>Seasonal commissioning reviews</li>
            <li>Soft Landings aftercare, where appropriate</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="sec-pad">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Proudly covering <b>all industry sectors</b></h2>
      </div>
      <div class="sector-grid rv rv-d1">
        <span>Care</span>
        <span>Commercial</span>
        <span>Defence</span>
        <span>Education</span>
        <span>Health Care</span>
        <span>Heritage</span>
        <span>Life Sciences</span>
        <span>Residential</span>
        <span>Studios &amp; Media</span>
        <span>Later Living</span>
      </div>
    </div>
  </section>

  <!-- VALUED CLIENTS -->
  <section class="sec-pad soft">
    <div class="wrap">
      <div class="shead2 rv">
        <div class="ndash"></div>
        <h2>Our valued <b>clients</b></h2>
      </div>
      <div class="client-grid rv rv-d1">
        <div class="lg"><img src="/assets/client-national-trust.png" alt="National Trust" /></div>
        <div class="lg"><img src="/assets/client-space-group.png" alt="Space Group" /></div>
        <div class="lg"><img src="/assets/client-cbre.png" alt="CBRE" /></div>
        <div class="lg"><img src="/assets/client-hallmark.png" alt="Hallmark Luxury Care" /></div>
        <div class="lg"><img src="/assets/client-lovett-care.jpg" alt="Lovett Care" /></div>
        <div class="lg"><img src="/assets/client-grayscourt.png" alt="Grayscourt" /></div>
        <div class="lg"><img src="/assets/client-batsford.png" alt="Batsford Arboretum" /></div>
        <div class="lg"><img src="/assets/client-met-office.jpg" alt="Met Office" /></div>
      </div>

      <div class="dl-panel rv">
        <div>
          <h3>Take our capabilities away to review</h3>
          <p>The full brochure covers our services, sector experience and case studies in detail.</p>
        </div>
        <a href="/Rubix-Capabilities-Brochure.pdf" class="btn btn-lime" download>Download the brochure (PDF) <span class="arr">&darr;</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

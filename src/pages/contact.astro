---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/contact.css';
import Skyline from '../components/Skyline.astro';
---
<BaseLayout
  title="Contact Us | MEP Consultants Birmingham | Rubix MEP"
  description="Contact Rubix MEP: building services consultants in Birmingham's Jewellery Quarter. JQ Modern, 120 Vyse Street, B18 6NF. Discuss your project."
>
  <!-- HERO: Jewellery Quarter line drawing as the banner -->
  <section class="page-hero">
    <div class="bg" role="img" aria-label="City skyline blended with forest treeline in Rubix navy duotone"></div>
    <div class="wrap">
      <h1 class="disp rv">Contact us</h1>
      <p class="lede rv rv-d1">Proudly located in the heart of Birmingham&rsquo;s historic Jewellery Quarter.</p>
    </div>
    <Skyline class="hero-sky" onDark={true} />
  </section>

  <!-- MAP with branded location tag -->
  <section class="mapblock">
    <div class="mapframe rv">
      <div class="inner">
        <div class="map-fallback" aria-hidden="true">
          <strong>Rubix MEP</strong>
          <span>120 Vyse Street<br />Jewellery Quarter, Birmingham B18 6NF</span>
          <span class="hint">Interactive map loads when online.<br />Tap below to open directions.</span>
        </div>
        <iframe title="Map: Rubix MEP, 120 Vyse Street, Birmingham B18 6NF" loading="lazy"
          src="https://maps.google.com/maps?q=Rubix%20MEP%20Consultants%2C%20120%20Vyse%20Street%2C%20Birmingham%20B18%206NF&z=16&output=embed"></iframe>
        <a class="map-tag" href="https://www.google.com/maps/search/Rubix+MEP+Consultants,+120+Vyse+Street,+Birmingham+B18+6NF" target="_blank" rel="noopener">
          <img src="/assets/logo-ident.png" alt="" />
          <span><span class="t1">Rubix MEP</span><span class="t2">120 Vyse Street</span></span>
        </a>
        <span class="map-dot" aria-hidden="true"></span>
      </div>
      <div class="map-address">
        <span><b>Rubix MEP Ltd.</b> &middot; JQ Modern, 120 Vyse Street, Jewellery Quarter, Birmingham B18 6NF</span>
        <a class="open" href="https://www.google.com/maps/search/Rubix+MEP+Consultants,+120+Vyse+Street,+Birmingham+B18+6NF" target="_blank" rel="noopener">Open in Google Maps &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CONTACT DETAILS (content per current live site) -->
  <section class="details">
    <div class="wrap">
      <div class="rv">
        <span class="kick">Get in touch</span>
        <h2 class="disp">Bring your design to life</h2>
        <p class="sub">Tell us about your project and the right person will come back to you.</p>
      </div>
      <div class="dgrid rv">
        <div class="dcard">
          <div class="lab">General enquiries</div>
          <a class="big" href="mailto:info@rubixmep.com">info@rubixmep.com</a>
        </div>
        <div class="dcard">
          <div class="lab">Careers</div>
          <a class="big" href="mailto:careers@rubixmep.com">careers@rubixmep.com</a>
        </div>
        <div class="dcard">
          <div class="lab">Office</div>
          <span class="big">JQ Modern, 120 Vyse Street<br />Jewellery Quarter, Birmingham B18 6NF</span>
        </div>
      </div>
      <div class="dirs rv rv-d1">
        <div class="dir">
          <h3>Alec Mabbott</h3>
          <div class="role" style="color:var(--lime)">Director</div>
          <a href="mailto:alec.mabbott@rubixmep.com"><b>E.</b> alec.mabbott@rubixmep.com</a>
        </div>
        <div class="dir">
          <h3>Stuart Growcott</h3>
          <div class="role" style="color:var(--blue)">Director</div>
          <a href="mailto:stuart.growcott@rubixmep.com"><b>E.</b> stuart.growcott@rubixmep.com</a>
        </div>
        <div class="dir">
          <h3>Daniel Williams</h3>
          <div class="role" style="color:var(--magenta)">Director</div>
          <a href="mailto:daniel.williams@rubixmep.com"><b>E.</b> daniel.williams@rubixmep.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- GETTING HERE -->
  <section class="travel">
    <div class="wrap">
      <div class="rv">
        <span class="kick">Getting here</span>
        <h2 class="disp">By car, train and tram</h2>
      </div>
      <div class="tgrid">
        <div class="tcard rv">
          <div class="ico"><svg viewBox="0 0 24 24"><path d="M5 16 6.5 10a2 2 0 0 1 2-1.5h7a2 2 0 0 1 2 1.5L19 16"/><rect x="4" y="16" width="16" height="4" rx="1.5"/><circle cx="7.5" cy="20" r="1.4"/><circle cx="16.5" cy="20" r="1.4"/></svg></div>
          <h3>By car</h3>
          <p>Minutes from Birmingham city centre and the A4540 ring road. The NCP Jewellery Quarter multi-storey car park is directly adjacent to the office on Vyse Street.</p>
        </div>
        <div class="tcard rv rv-d1">
          <div class="ico"><svg viewBox="0 0 24 24"><rect x="6" y="3" width="12" height="13" rx="2.5"/><line x1="6" y1="9" x2="18" y2="9"/><circle cx="9.5" cy="13" r="1"/><circle cx="14.5" cy="13" r="1"/><path d="M8 16 6 21 M16 16 18 21 M7 19.5 h10"/></svg></div>
          <h3>By train</h3>
          <p>Jewellery Quarter station on Vyse Street is a short walk (under 5 minutes) from the office, with direct services to Birmingham Snow Hill and Moor Street in under ten minutes.</p>
        </div>
        <div class="tcard rv rv-d2">
          <div class="ico"><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="12" rx="2.5"/><line x1="5" y1="11" x2="19" y2="11"/><line x1="9" y1="2 " x2="15" y2="2"/><line x1="12" y1="2" x2="12" y2="5"/><circle cx="8.5" cy="19.5" r="1.2"/><circle cx="15.5" cy="19.5" r="1.2"/></svg></div>
          <h3>By tram</h3>
          <p>The West Midlands Metro stops at Jewellery Quarter station on Vyse Street, connecting directly to St Paul&rsquo;s, Bull Street and Birmingham New Street via Grand Central. It is a short (under 5 minute) walk from the station to JQ Modern.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

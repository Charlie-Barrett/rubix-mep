---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about.css';
import Cta from '../components/Cta.astro';
import Skyline from '../components/Skyline.astro';

// Director bios and bullets per the client's 01.10 review. Each director carries one
// accent colour (Alec green, Stuart light blue, Dan pink) for the role and bullets.
const directors = [
  {
    name: 'Alec Mabbott', img: '/assets/alec.webp', accent: 'var(--lime)',
    bio: 'As a CIBSE Chartered Engineer (CEng MCIBSE) with a mechanical engineering bias and over 15 years&rsquo; experience, Alec has delivered small to large-scale projects with complex MEP requirements across a range of sectors. He regularly fulfils a client-facing role and leads multi-disciplinary design teams to project success, combining practical engineering design with expertise in Revit 3D modelling, BIM coordination and <span class="c-green">carbon</span> impact studies.',
    points: ['Multi-sector expertise', 'Sustainability &amp; <span class="c-green">Carbon</span> Impact Studies Lead', 'Building Information Modelling (BIM) Lead']
  },
  {
    name: 'Stuart Growcott', img: '/assets/stuart.webp', accent: 'var(--blue)',
    bio: 'Stuart has 30 years of experience across the construction industry, with a proven track record managing multi-discipline teams to deliver innovative building services project solutions. His approach has benefited from having worked for both Contractors and Consultancy practices, gaining a comprehensive understanding of building services solutions to meet environmental, economic, and social responsibilities whilst adopting pragmatic and holistic design methods.',
    points: ['30+ years&rsquo; experience', 'Expertise in Healthcare &amp; Later Living', 'Experience in both contracting &amp; consultancy']
  },
  {
    name: 'Daniel Williams', img: '/assets/daniel.webp', accent: 'var(--magenta)',
    bio: 'As a Chartered Electrical Engineer (BEng (Hons), CEng, MIET) with over 20 years&rsquo; experience, Daniel combines hands-on installation knowledge with technical design expertise, having started his career carrying out electrical installations on site. He has led teams on numerous successful projects across a variety of sectors and delivered MEP engineering design for projects ranging from concept through to detailed design and installation. Daniel has extensive experience in both new-build and refurbishment schemes, including heritage and historic buildings.',
    points: ['Electrical Lead', '20+ years&rsquo; experience', 'Multi-sector expertise']
  }
];

// Wider team. `z` zooms a headshot in (and `oy` raises the crop) where the client
// asked for a tighter torso-and-head framing to match the others. All headshots are
// due to be reshot on 19 October; Sarah's photo is still to come.
const team = [
  { img: '/assets/staff-tm.jpg', z: 1.3, oy: '45%', ty: '-15%' },
  { img: '/assets/staff-ww.jpg', z: 1.25, oy: '42%', ty: '-10%' },
  { img: '/assets/staff-fs.jpg', z: 1.3, oy: '48%', ty: '-17%' },
  { img: '/assets/staff-ab.jpg' },
  { img: '/assets/staff-ak.jpg', z: 1.4, oy: '45%', ty: '-15%' },
  { img: '/assets/staff-db.jpg', z: 1.25, oy: '33%', ty: '-5%' },
  { img: '/assets/staff-as.jpg' },
  { img: '/assets/staff-ld.jpg', z: 1.3, oy: '42%', ty: '-12%' }
];
---
<BaseLayout
  title="About Us | MEP Consultants, Birmingham | Rubix MEP"
  description="Building services engineering built on trust. Meet the Rubix MEP team: directors Alec Mabbott, Stuart Growcott and Daniel Williams and a multidisciplinary team in Birmingham's Jewellery Quarter."
  showCta={false}
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="bg" role="img" aria-label="City skyline blended with forest treeline in Rubix navy duotone"></div>
    <div class="wrap">
      <h1 class="disp rv">Building services engineering built on <span class="c-blue">trust</span>.</h1>
      <p class="lede rv rv-d1">Our people are at the heart of Rubix MEP. Guided by honesty, integrity and trust, we combine technical excellence with pragmatic engineering to deliver innovative solutions and exceptional outcomes for our clients.</p>
    </div>
  </section>

  <!-- LOCATION STRIP: Jewellery Quarter -->
  <section class="locstrip">
    <Skyline class="ls-sky" />
    <div class="wrap">
      <div class="ls-txt rv">
        <h2 class="disp">Proudly based in Birmingham&rsquo;s Jewellery Quarter. Working across the UK.</h2>
      </div>
    </div>
  </section>

  <!-- THE RUBIX MEP TEAM: directors and the wider team in one section (01.10 review) -->
  <section class="team" id="team">
    <div class="wrap">
      <div class="tlabel rv">
        <div class="ndash"></div>
        <h2>The <b>Rubix MEP</b> team</h2>
        <p class="copy">Our directors, Alec, Stuart and Daniel have over 50 years&rsquo; experience leading MEP design teams and delivering multidisciplinary projects for a variety of clients across all sectors of the industry.</p>
      </div>
      <div class="dirs" id="leadership">
        {directors.map((d, i) => (
          <article class={'dcard rv' + (i ? ` rv-d${i}` : '')} style={`--acc:${d.accent}`}>
            <div class="ph"><img src={d.img} alt={`${d.name}, Director`} /></div>
            <div class="body">
              <h3>{d.name}</h3>
              <div class="role">Director</div>
              <p set:html={d.bio} />
              <ul>{d.points.map((pt) => <li set:html={pt} />)}</ul>
            </div>
          </article>
        ))}
      </div>
      <div class="tgrid">
        {team.map((t, i) => (
          <div class={'tcell rv' + (i % 4 ? ` rv-d${i % 4}` : '')} style={t.z ? `--z:${t.z}; --oy:${t.oy}; --ty:${t.ty}` : undefined}>
            <img src={t.img} alt="Rubix MEP team member" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VISION / VALUES / MISSION: moved to the foot of the page (01.10 review) -->
  <section class="vvm">
    <div class="wrap">
      <div class="rv">
        <div class="ndash navy"></div>
        <h2 class="bar">Our vision. Our values. Our mission.</h2>
      </div>
      <div class="vitems">
        <div class="vitem rv" style="--acc:var(--lime)"><div class="n">1</div><p>Exceed our obligation as engineers to champion low-<span class="c-green">carbon</span> developments that enhance the local, national and global environment.</p></div>
        <div class="vitem rv rv-d1" style="--acc:var(--magenta)"><div class="n">2</div><p>Keep our values of honesty, integrity and trust at the forefront. To achieve best-in-class standards at each and every step. And, to provide our clients with expert advice, innovative yet pragmatic engineering solutions and the highest level of competency to deliver their aspirations.</p></div>
        <div class="vitem rv rv-d2" style="--acc:var(--blue)"><div class="n">3</div><p>Focus on delivering low-<span class="c-green">carbon</span>, innovative building services design solutions that are tailored to our client&rsquo;s needs.</p></div>
      </div>
    </div>
  </section>

  <!-- CAREERS: expression of interest form, in place of the project CTA on this page -->
  <Cta
    id="careers"
    kind="careers"
    light={true}
    title="Want to join the team?"
    sub="We're a strong, multidisciplinary team and we're still growing. Leave your details and we will be in touch."
    buttonLabel="Register your interest"
    messageLabel="Tell us a little about yourself"
    email="careers@rubixmep.com"
  />
</BaseLayout>

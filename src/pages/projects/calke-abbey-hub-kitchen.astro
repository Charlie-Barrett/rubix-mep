---
import CaseStudy from '../../layouts/CaseStudy.astro';
---
<CaseStudy
  metaTitle="Calke Abbey Hub Kitchen | Heritage MEP Case Study | Rubix MEP"
  metaDesc="Case study: full RIBA Stage 4 MEP design and construction support for the new Hub Kitchen, BBQ kiosk and refurbishment works at National Trust Calke Abbey, Derbyshire, completed summer 2026. c. £1.2m."
  name="Calke Abbey Hub Kitchen"
  heroImage="/assets/calke-abbey-hub-kitchen.jpg"
  capsules={[
    { text: 'Heritage &middot; Food &amp; Beverage' },
    { text: 'c. &pound;1.2m', alt: true },
    { text: 'The National Trust', alt: true }
  ]}
  lede="Full RIBA Stage 4 MEP design and construction support for the regeneration of the Food &amp; Beverage offer at Calke Abbey, Derbyshire: a new-build Hub Kitchen with roof-mounted solar PV, a BBQ kiosk and refurbishment works, completed in the summer of 2026."
  glance={[
    { n: 'National Trust', l: 'Client' },
    { n: 'c. &pound;1.2m', l: 'Construction value' },
    { n: '2026', l: 'Completed summer 2026' },
    { n: 'RIBA 4', l: 'Design + construction support' },
    { n: 'Solar PV', l: 'Roof-mounted, assessed and designed' }
  ]}
  overview={[
    'Completed in the summer of 2026, the project encompassed the <b>regeneration of the existing Food &amp; Beverage (F&amp;B) offers at the Calke Abbey site</b>, in Derbyshire.',
    'The project comprised the erection of a <b>new-build &lsquo;Hub Kitchen&rsquo; building, a BBQ kiosk and refurbishment works</b> to staff offices, the Finishing Kitchen and the Welcome Kiosk.',
    'Rubix MEP were appointed for <b>full RIBA Stage 4 MEP design duties and subsequent construction support through to completion</b>, beginning with MEP feasibility assessments of all areas and a <span class="c-green">carbon</span> impact study and energy assessment.'
  ]}
  images={[
    { src: '/assets/calke-abbey-hub-kitchen.jpg', alt: 'The new timber-clad Hub Kitchen at Calke Abbey with a roof-mounted solar PV array' }
  ]}
  quote={{
    text: 'They have the ability to present and communicate sometimes complex and technical work in a manner understandable to the layman: an important skill to facilitate prompt project progression.',
    by: 'Richard Fennell',
    org: 'National Trust Project Manager, F&B'
  }}
  scope={[
    { h: 'Feasibility &amp; <span class="c-green">carbon</span>', p: 'Initial MEP feasibility assessments of all areas, and a <span class="c-green">Carbon</span> Impact Study (CIS) and energy assessment for the site.' },
    { h: 'Overheating &amp; design', p: 'Overheating assessment of the new Hub Kitchen using dynamic thermal modelling, and RIBA Stage 4 MEP design drawings and schedules.' },
    { h: 'Solar PV &amp; construction', p: 'Roof-mounted solar PV assessment and design, with construction support through to completion.' }
  ]}
  chipsLabel="Appointment highlights"
  chips={['RIBA Stage 4', '<span class="c-green">Carbon</span> Impact Study', 'Dynamic thermal modelling', 'Roof-mounted solar PV', 'Construction support', 'Completed 2026']}
  ctaSub="Heritage estate, visitor attraction or sensitive site. Start the conversation."
  relatedServices={[
    { label: '<span class="c-green">Carbon</span> impact studies', href: '/services/carbon-impact-studies' },
    { label: 'Building Physics', href: '/services#building-physics' },
    { label: 'Electrical design', href: '/services#electrical' }
  ]}
  otherProjects={[
    { label: 'Tyntesfield Cow Barn', href: '/projects/tyntesfield-cow-barn' },
    { label: 'National Trust <span class="c-green">Carbon</span> Studies', href: '/projects/national-trust-carbon-impact-studies' },
    { label: 'Batsford Arboretum', href: '/projects/batsford-arboretum' }
  ]}
/>

import CaseStudy from '../../layouts/CaseStudy.astro';
---
<CaseStudy
  metaTitle="Batsford Arboretum | Heritage MEP Case Study | Rubix MEP"
  metaDesc="Case study: RIBA Stage 4 MEP design for the £2m visitor building extension at Batsford Arboretum, with air source heat pumps and greywater recycling reducing its carbon footprint."
  name="Batsford Arboretum"
  capsules={[
    { text: 'Heritage &middot; Visitor Attraction' },
    { text: 'c. &pound;2.0m', alt: true },
    { text: 'Grayscourt', alt: true }
  ]}
  lede="RIBA Stage 4 MEP design for a contemporary 420m&sup2;+ extension to the visitor building at Batsford Arboretum: a high-specification kitchen, cafe and garden shop, engineered with low-<span class='c-green'>carbon</span> technologies in a sensitive historic setting."
  glance={[
    { n: 'Grayscourt', l: 'Client' },
    { n: 'c. &pound;2.0m', l: 'Construction value' },
    { n: '420m&sup2;+', l: 'New extension' },
    { n: 'RIBA 4', l: 'Detailed MEP design' },
    { n: 'ASHP', l: '+ greywater recycling' }
  ]}
  overview={[
    'Batsford Arboretum is home to a unique collection of some of the world&rsquo;s most beautiful and rare trees spread over c.56 acres, together with an existing garden centre, garden terrace cafe and gift shop.',
    'The new extension project expanded the existing building by <b>over 420m&sup2;</b>, providing a high-specification kitchen, cafe and garden shop. The contemporary building design respects the historic arboretum and its surroundings, with environmental features including FSC timber, sheep&rsquo;s wool insulation, heat pumps and rainwater harvesting.',
    'Rubix MEP were responsible for the <b>RIBA Stage 4 detailed design of the MEP services</b>, including LV distribution, lighting and emergency lighting, small power and data, fire alarm, heating, ventilation, hot and cold water and LPG gas services.'
  ]}
  quote={{
    text: 'Rubix were fantastic to work with and were highly professional from start to finish. We&rsquo;re delighted with the finished spaces that they helped create.',
    by: 'Stuart Priest',
    org: 'The Batsford Foundation'
  }}
  scope={[
    { h: 'RIBA Stage 4 MEP design', p: 'Detailed design of the full MEP services: LV distribution, lighting and emergency lighting, small power and data, fire alarm, heating, ventilation, hot and cold water and LPG gas.' },
    { h: 'Low-<span class="c-green">carbon</span> technologies', p: 'Air source heat pumps and greywater recycling systems, providing on-site sustainable energy and helping to reduce the building&rsquo;s <span class="c-green">carbon</span> footprint.' },
    { h: 'Sensitive heritage setting', p: 'Services engineered around a contemporary building design that respects the historic arboretum and its surrounding environment.' }
  ]}
  chipsLabel="Appointment highlights"

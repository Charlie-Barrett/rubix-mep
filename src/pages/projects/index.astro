---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages.css';
import { projects, indexExtra } from '../../data/projects.js';

// Order, capsule text and accent colour come from the shared featured-projects data
// (01.10 review: "see main page comments for each project"); Batsford follows the eleven.
const cards = [...projects, ...indexExtra];
---
<BaseLayout
  title="Projects | MEP Case Studies | Rubix MEP"
  description="MEP design case studies from Rubix MEP: later living, residential, heritage, retail and hospitality, mixed-use and site-wide carbon impact studies across the UK."
>
  <section class="page-hero">
    <div class="bg" role="img" aria-label="City skyline blended with forest treeline in Rubix navy duotone"></div>
    <div class="wrap">
      <h1 class="disp rv">Our projects</h1>
      <p class="lede rv rv-d1">Diverse sectors. Complex challenges. Proven solutions. Explore a portfolio of projects that demonstrates the depth and versatility of Rubix MEP building services engineering.</p>
    </div>
  </section>

  <section class="sec-pad soft">
    <div class="wrap wide">
      <div class="shead2 rv">
        <div class="ndash navy"></div>
        <h2>Case <b>studies</b></h2>
      </div>
      <div class="pgrid">
        {cards.map((p, i) => (
          <a class={'pcard rv' + (i % 2 === 1 ? ' rv-d1' : '')} href={`/projects/${p.slug}`} aria-label={p.alt} style={`--acc:${p.accent}`}>
            <div class="fill" style={`background-image:url('${p.img}')`}></div>
            <div class="shade"></div>
            <div class="capsules">
              <span class="capsule" set:html={p.capsule} />
              <span class="capsule alt" set:html={p.indexTag} />
            </div>
            <span class="more">View project <span class="arr">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

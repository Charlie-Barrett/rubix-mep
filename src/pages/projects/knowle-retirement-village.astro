---
import CaseStudy from '../../layouts/CaseStudy.astro';
---
<CaseStudy
  metaTitle="Knowle Retirement Village | Later Living MEP Case Study | Rubix MEP"
  metaDesc="Case study: complete MEP design for Knowle Retirement Village, a c. £34m later living community for Opus Villages, with an energy strategy targeting EPC A and net zero carbon."
  name="Knowle Retirement Village"
  heroImage="/assets/knowle.jpg"
  capsules={[
    { text: 'Later Living &amp; Care' },
    { text: 'c. &pound;34.0m', alt: true },
    { text: 'Opus Villages', alt: true }
  ]}
  lede="Complete MEP design and specification for a high-end later living community: 46 village apartments across seven maisonette-style buildings and 39 village suites within a three-storey community building, with an energy strategy targeting EPC A and net zero <span class='c-green'>carbon</span>."
  glance={[
    { n: 'Opus Villages', l: 'Client' },
    { n: 'c. &pound;34.0m', l: 'Construction value' },
    { n: '46 + 39', l: 'Apartments &amp; suites' },
    { n: 'RIBA 3', l: 'Concept to Stage 3 + monitoring' },
    { n: 'EPC A', l: 'Net zero energy options' }
  ]}
  overview={[
    'Knowle Retirement Village is a high-end later living retirement community: <b>46 village apartments across seven two-storey maisonette-style buildings</b>, with a further <b>39 village suite apartments</b> contained within the central community building.',
    'The three-storey community building provides central support alongside a restaurant, lounge, coffee bar, library, treatment room, gym, hair salon and private dining, together with ancillary catering and laundry provisions.',
    'Rubix MEP were appointed to undertake the <b>complete MEP design and specification from conception to RIBA Stage 3</b>. The appointment continues as a client monitoring role through the contractor design and construction process, including witnessing of testing and commissioning through to project close-out.'
  ]}
  images={[
    { src: '/assets/knowle.jpg', alt: 'Knowle Retirement Village: village apartments and landscaped grounds' },
    { src: '/assets/knowle-courtyard-cgi.jpg', alt: 'CGI of Knowle Retirement Village courtyard: maisonette-style apartment buildings around landscaped gardens and walkways' }
  ]}
  quote={{
    text: 'Rubix are a highly proactive consultancy. They have the technical know-how and have helped us navigate all the latest legislation and statutory requirements. They have worked extremely well for us against tight deadlines and kept us well informed at all stages.',
    by: 'Patrick Egan',
    org: 'Opus Villages'
  }}
  scope={[
    { h: 'Stage 3 design in BIM', p: 'Complete MEP design and specification from conception to RIBA Stage 3, delivered with Revit / BIM Level 2 output.' },
    { h: 'Energy strategy', p: 'Options appraised for EPC A and net zero <span class="c-green">carbon</span>, with operational energy calculations aligned to the client&rsquo;s marketing strategy.' },
    { h: 'Client-side monitoring', p: 'Tender evaluations and technical support, then monitoring through contractor design and construction, witnessing testing and commissioning to close-out.' }
  ]}
  chipsLabel="Appointment highlights"
  chips={['Conception &rarr; RIBA Stage 3', 'Revit / BIM Level 2', 'EPC A &amp; net zero options', 'Tender evaluations', 'Commissioning witnessing', 'Project close-out']}
  ctaSub="Later living, care or retirement community. Start the conversation."
  relatedServices={[
    { label: 'Mechanical design', href: '/services#mechanical' },
    { label: 'Sustainability', href: '/services#sustainability' },
    { label: '<span class="c-green">Carbon</span> impact studies', href: '/services/carbon-impact-studies' }
  ]}
  otherProjects={[
    { label: 'The Lampworks', href: '/projects/the-lampworks' },
    { label: 'Shepperton Studios', href: '/projects/shepperton-studios' },
    { label: 'National Trust <span class="c-green">Carbon</span> Studies', href: '/projects/national-trust-carbon-impact-studies' }
  ]}
/>

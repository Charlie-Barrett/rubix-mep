---
import CaseStudy from '../../layouts/CaseStudy.astro';
---
<CaseStudy
  metaTitle="The Lampworks | Residential MEP Case Study | Rubix MEP"
  metaDesc="Case study: full RIBA Stage 4C MEP design for The Lampworks, a c. £23m build-to-rent development of 148 apartments in Birmingham's Jewellery Quarter."
  name="The Lampworks"
  heroImage="/assets/lampworks-cgi.png"
  capsules={[
    { text: 'Residential &middot; Build to Rent' },
    { text: 'c. &pound;23.0m', alt: true },
    { text: 'Jewellery Quarter, Birmingham', alt: true }
  ]}
  lede="Full MEP design for a new mixed-use, build-to-rent development of 148 apartments across five blocks, with landscaped courtyards and communal spaces, in Birmingham&rsquo;s historic Jewellery Quarter. On Rubix&rsquo;s own doorstep."
  glance={[
    { n: 'Regal ME /<br />Build Fifty5', l: 'Client' },
    { n: 'c. &pound;23.0m', l: 'Construction value' },
    { n: '148', l: 'Apartments &middot; 5 blocks' },
    { n: 'RIBA 4C', l: 'To construction issue' },
    { n: 'BIM Level 2', l: '3D Revit coordination' }
  ]}
  overview={[
    'The Lampworks is a new mixed-use, residential build-to-rent development comprising <b>148 apartments across five blocks</b> of one-, two- and three-bedrooms, alongside landscaped courtyards and communal spaces in Birmingham&rsquo;s historic Jewellery Quarter.',
    'Rubix MEP were appointed for <b>full RIBA Stage 4C MEP design duties through to construction issue</b>, working directly for the appointed MEP contractor, Regal ME.',
    'Delivering construction-issue design at this scale means every drawing, schedule and builderswork detail has to be coordinated and buildable. The full design was developed in <b>3D Revit to BIM Level 2</b>, coordinated across the architectural, structural and interiors teams before reaching site.'
  ]}
  images={[
    { src: '/assets/lampworks-cgi.png', alt: 'CGI of The Lampworks: red-brick five-storey street frontage with bar and cafe units at ground floor' },
    { src: '/assets/lampworks-street.jpg', alt: 'CGI of The Lampworks gable signage above tree-lined street cafe seating' }
  ]}
  scope={[
    { h: 'Construction-issue design', p: 'RIBA Stage 4C construction issue MEP design drawings and full equipment and plant schedules, ready to build from.' },
    { h: 'BIM Level 2 coordination', p: 'Detailed 3D Revit coordination across all five blocks, clash-resolved against structure and architecture before site.' },
    { h: 'BWIC &amp; construction support', p: 'Full builderswork in construction detailing, plus ongoing technical support to the contractor team through delivery.' }
  ]}
  chips={['Regal ME', 'Build FiftyFive', 'BPN Architects', 'SBK Civil / Structural', 'Space Interiors']}
  ctaSub="Residential, build-to-rent or mixed-use. Start the conversation."
  relatedServices={[
    { label: 'Mechanical design', href: '/services#mechanical' },
    { label: 'Electrical design', href: '/services#electrical' },
    { label: 'Public health design', href: '/services#public-health' }
  ]}
  otherProjects={[
    { label: 'Opus, Knowle', href: '/projects/knowle-retirement-village' },
    { label: 'Shepperton Studios', href: '/projects/shepperton-studios' },
    { label: 'National Trust <span class="c-green">Carbon</span> Studies', href: '/projects/national-trust-carbon-impact-studies' }
  ]}
/>
